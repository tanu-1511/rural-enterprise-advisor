# Copy this file to .env and adjust values for local development.
# Never commit a real .env file.

FLASK_ENV=development

# Secret used to sign JWTs. Replace with any random string for local use.
JWT_SECRET=replace-with-local-development-secret
JWT_EXPIRY_MINUTES=60

# MongoDB connection string for local development.
MONGODB_URI=mongodb://localhost:27017/rural_enterprise_advisor

# Set to "true" to use an in-memory data store instead of MongoDB
# (useful if you don't have MongoDB running locally).
USE_IN_MEMORY_DB=false

# Demo-only login credentials for this POC. These are NOT real secrets.
DEMO_USERNAME=coordinator
DEMO_PASSWORD=demo-password-123
